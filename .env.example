# Supabase Configuration
# Replace these values with your own Supabase project URL and Anon API Key
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Enable demo mode to bypass Supabase auth and load the app as a mock admin
# Set to 'true' to try the UI locally without setting up Supabase
VITE_ENABLE_DEMO_MODE=false

# AI Configuration (Gemini, Groq, or xAI API key)
# Get a free Google Gemini key at https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your-gemini-api-key-here
VITE_GROQ_API_KEY=your-groq-api-key-here
VITE_XAI_API_KEY=your-xai-api-key-here


